{
    "name": "portal",
    "private": true,
    "version": "1.8.1-next.0",
    "description": "Dokumentasjonsportal for Jøkul designsystem",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "predev": "pnpm sync-assets",
        "prebuild": "pnpm sync-assets",
        "test": "vitest run --config vite.test.config.mjs",
        "sync-assets": "pnpm sync-fonts && pnpm sync-images",
        "sync-fonts": "mkdir -p public/fonts public/fonts/brands && cp -R ../packages/jokul/src/fonts/brands/fremtind/. public/fonts/ && cp -R ../packages/jokul/src/fonts/brands/. public/fonts/brands/",
        "sync-images": "mkdir -p public/images && cp -R ../storybook-public/images/. public/images/",
        "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3333 --webpack",
        "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3333 --webpack",
        "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
        "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
        "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3333",
        "typegen": "sanity schema extract --path=src/sanity/extract.json && sanity typegen generate"
    },
    "dependencies": {
        "@fremtind/jokul": "workspace:*",
        "@mdx-js/loader": "^3.1.0",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "^16.3.0",
        "@portabletext/react": "^5.0.0",
        "@portabletext/types": "^3.0.1",
        "@sanity/client": "^7.26.0",
        "@sanity/code-input": "^6.0.4",
        "@sanity/icons": "^3.8.0",
        "@sanity/image-url": "^2.1.1",
        "@sanity/locale-nb-no": "^1.1.36",
        "@sanity/table": "^2.0.1",
        "@sanity/ui": "^3.5.1",
        "@sanity/vision": "^4.22.0",
        "@types/mdx": "^2.0.14",
        "chroma-js": "^3.2.0",
        "colorjs.io": "0.6.1",
        "cookies-next": "^6.0.0",
        "cross-env": "^10.1.0",
        "dompurify": "^3.4.13",
        "graphql": "^16.14.2",
        "hsluv": "^1.0.2",
        "mixpanel-browser": "^2.81.0",
        "next": "^16.3.0",
        "next-sanity": "^11.6.13",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-live": "^4.1.8",
        "sanity": "^4.22.0",
        "sharp": "^0.35.0",
        "slugify": "^1.6.9",
        "styled-components": "^6.4.4",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@types/chroma-js": "^3.1.2",
        "@types/node": "^24.13.3",
        "@types/react": "18.3.1",
        "@types/react-dom": "18.3.1",
        "@vitejs/plugin-react": "^4.7.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.2.4",
        "jsdom": "^26.1.0",
        "typescript": "^5.8.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
    }
}

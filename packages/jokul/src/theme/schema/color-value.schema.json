{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://jokul.fremtind.no/schemas/v1/color-value.schema.json",
    "title": "Fargerolle",
    "description": "En fargerolle med verdier for mørk og lys modus, til bruk i Jøkul-tema",
    "type": "object",
    "properties": {
        "value": {
            "type": "object",
            "properties": {
                "light": {
                    "type": "string"
                },
                "dark": {
                    "type": "string"
                }
            },
            "required": ["light", "dark"]
        }
    },
    "required": ["value"]
}
